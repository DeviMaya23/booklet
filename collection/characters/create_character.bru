meta {
  name: Create Character
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/characters
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Selni",
    "notes": "A boisterous blacksmith from Dyffrynne.",
    "folder_ids": [],
    "is_public": false
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("characterId", res.body.id);
  }
}
