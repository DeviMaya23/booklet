meta {
  name: Initial Upload
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/images
  body: json
  auth: inherit
}

body:json {
  {
    "mime_type": "image/jpeg",
    "title": "Test Image",
    "artist_id": null,
    "notes": "Test notes",
    "character_ids": []
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("presignedUrl", res.body.upload_url);
    bru.setVar("pendingUploadId", res.body.id);
    bru.setVar("imageId", res.body.id);
  }
}
