meta {
  name: Create Artist
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/artists
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Jane Doe",
    "notes": "A talented artist.",
    "links": [
      { "url": "https://example.com/janedoe", "is_primary": true },
      { "url": "https://twitter.com/janedoe", "is_primary": false }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("artistId", res.body.id);
  }
}
