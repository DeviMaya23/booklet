meta {
  name: Update Artist
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/artists/:id
  body: json
  auth: inherit
}

params:path {
  id: {{artistId}}
}

body:json {
  {
    "name": "Updated Name",
    "notes": "Updated notes.",
    "artist_link": "https://example.com/updated"
  }
}

vars:pre-request {
  artistId: 88e92ff9-8443-4fe8-97a0-73e572fc6787
}
