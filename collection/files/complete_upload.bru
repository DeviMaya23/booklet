meta {
  name: Complete File Upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/files/{{pendingFileUploadId}}/complete
  body: json
  auth: inherit
}

body:json {
  {
  //   "width": 1920,
  //   "height": 1080
  }
}

vars:pre-request {
  pendingFileUploadId: e9a77f23-2530-4283-8886-0b962c378253
}

docs {
  ## Body (optional)

  For image files, pass the dimensions obtained from the browser-side thumbnail
  generation. Omit for non-image files.

  ```json
  {
    "width": 1920,
    "height": 1080
  }
  ```

  ## Response

  ```json
  {
    "id": "uuid",
    "file_url": "https://...",
    "mime_type": "image/jpeg",
    "thumbnail_url": "https://... | null",
    "artpiece_id": null,
    "name": "sketch.jpg",
    "notes": null,
    "created_at": "2024-01-01T00:00:00Z",
    "updated_at": "2024-01-01T00:00:00Z"
  }
  ```
}
