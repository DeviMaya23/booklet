meta {
  name: Update File
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/files/{{fileId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "my sketch.png",
    "notes": "Some notes about this file."
  }
}

