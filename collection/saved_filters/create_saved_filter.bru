meta {
  name: Create Saved Filter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/saved_filters
  body: json
  auth: inherit
}

body:json {
  {
    "name": "My Filter",
    "thumbnail_r2_path": null,
    "filter_payload": {
      "artists": [],
      "characters": [],
      "match_mode": "all"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("savedFilterId", res.body.id);
  }
}
