meta {
  name: Create Saved Filter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/saved_filters
  body: json
  auth: inherit
}

body:json {
  {
    "name": "My Filter",
    "thumbnail_artpiece_id": null,
    "filter_payload": {
      "artist_id": null,
      "character_ids": [],
      "match_mode": "all"
    }
  }
}

// Response (201):
// {
//   "id": "<uuid>",
//   "name": "My Filter",
//   "thumbnail_url": "<signed-url or null>",
//   "filter_payload": { "artist_id": null, "character_ids": [], "match_mode": "all" },
//   "created_at": "...",
//   "updated_at": "..."
// }

script:post-response {
  if (res.status === 201) {
    bru.setVar("savedFilterId", res.body.id);
  }
}
