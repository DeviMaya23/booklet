meta {
  name: Create Commission
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/commissions
  body: json
  auth: inherit
}

body:json {
  {
    "title": null,
    "artist_id": null,
    "status": "waitlist",
    "price": null,
    "paid": false,
    "paid_date": null,
    "finish_date": null,
    "notes": null,
    "character_ids": [],
    "artpiece_ids": []
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("commissionId", res.body.id);
  }
}
