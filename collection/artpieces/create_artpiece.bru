meta {
  name: Create Artpiece
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/artpieces
  body: json
  auth: inherit
}

body:json {
  {
    "title": "My Artwork",
    "artist_id": null,
    "notes": "Some notes.",
    "character_ids": [],
    "tag_ids": [],
    "file_ids": [],
    "is_reference": false
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("artpieceId", res.body.id);
  }
}

docs {
  tag_ids: optional array of tag UUIDs owned by the user (duplicates are ignored).
  A tag that does not exist or belongs to another user returns 422.
  The response includes `tags` as an array of { id, name } (empty when none).
}
