meta {
  name: List Artpieces
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/artpieces
  body: none
  auth: inherit
}

params:query {
  ~artist_ids: {{artistId}}
  ~character_ids: {{characterId}}
  ~is_reference: true
  ~tag_ids: {{tagId}}
  ~tag_match: any
}

vars:pre-request {
  characterId: 8f9acc37-4836-4f3a-84f5-9966ac387460
}

docs {
  Response includes cover file fields when cover_file_id is non-null:
    cover_file_url       - presigned GET URL for the full-resolution cover file
    cover_file_mime_type - MIME type of the cover file (e.g. "image/jpeg")
    cover_file_name      - name of the cover file, null if unnamed
  All three are null when the artpiece has no cover.

  Each artpiece includes `tags` as an array of { id, name } (empty when none).

  Tag filter:
    tag_ids   - repeatable; artpieces carrying the given tags
    tag_match - "any" (default): has at least one of the tags; "all": has every tag
  A non-UUID tag_ids or a tag_match other than any/all returns 400.
}
